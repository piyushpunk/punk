[TEMPLATE]
# ─── Server ──────────────────────────────────────────────────────────────────
PORT=8000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# ─── Database ────────────────────────────────────────────────────────────────
MONGODB_URI=your-mongodb-atlas-connection-string

# ─── JWT ─────────────────────────────────────────────────────────────────────
ACCESS_TOKEN_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRY=1d
REFRESH_TOKEN_SECRET=change-me-to-a-different-long-random-string
REFRESH_TOKEN_EXPIRY=10d

# ─── Cloudinary (product/brand images) ───────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ─── Razorpay (phase-5 checkout; system works without it in dev) ─────────────
# When absent, checkout marks orders pending_payment and admins confirm
# them manually via PATCH /api/v1/orders/admin/:id/status
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ─── Brevo (email HTTP API — REQUIRED in production on Render) ───────────────
# Render free tier BLOCKS all outbound SMTP ports (25/465/587) — Gmail SMTP
# cannot connect from Render. Brevo sends over HTTPS:443 instead. Free tier:
# 300 emails/day. 1) Create account at brevo.com  2) Senders → add & verify
# akuma04313@gmail.com  3) SMTP & API → API keys → generate key.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=akuma04313@gmail.com
BREVO_SENDER_NAME=AKUMA

# ─── SMTP (fallback for local dev; ignored once BREVO_API_KEY is set) ────────
# Gmail: create an App Password (Google Account → Security → 2-Step Verification
# → App passwords), then SMTP_HOST=smtp.gmail.com SMTP_PORT=587 (local dev only)
# SMTP_USER=you@gmail.com SMTP_PASS=<16-char app password> SMTP_FROM=you@gmail.com
# Any other provider: set host/port/user/pass accordingly (port 465 = secure).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ─── Production (Render) ─────────────────────────────────────────────────────
# Set CORS_ORIGIN to your Vercel frontend URL, and FRONTEND_URL to the same
# (password-reset email links point there).
#   CORS_ORIGIN=https://punkstudios.vercel.app
#   FRONTEND_URL=https://punkstudios.vercel.app
# Full deploy guide: docs/render-migration.md
